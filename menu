let cart = {};
let currentDish = null;

/* ========== МОДАЛКИ ========== */
function openRules() {
    document.getElementById('rulesModal').classList.add('active');
    document.body.style.overflow = 'hidden';
}
function openCart() {
    renderCartContent();
    document.getElementById('cartModal').classList.add('active');
    document.body.style.overflow = 'hidden';
}
function closeModal(e, id) {
    if (e && e.target !== e.currentTarget) return;
    document.getElementById(id).classList.remove('active');
    setTimeout(() => {
        if (!document.querySelector('.modal-overlay.active')) document.body.style.overflow = '';
    }, 50);
}

/* ========== РЕНДЕР МЕНЮ ========== */
function renderMenu() {
    const grid = document.getElementById('menuGrid');
    grid.innerHTML = menuData.map(cat => `
        <div class="category">
            <div class="category-title">${cat.category} <small>${cat.note}</small></div>
            ${cat.items.map(item => `
                <div class="item" onclick="openDish('${item.id}')">
                    <img src="${item.img}" alt="${item.name}" class="item-img" loading="lazy"
                         onerror="this.style.opacity='0.15'">
                    <div class="item-body">
                        <div class="item-info">
                            <div class="item-name">${item.name}</div>
                            ${item.desc ? `<div class="item-desc">${item.desc}</div>` : ''}
                            <div class="item-kbju">
                                <span class="kbju-cal">🔥 ${item.kbju.cal} ккал</span>
                                <span>Б: ${item.kbju.p}</span>
                                <span>Ж: ${item.kbju.f}</span>
                                <span>У: ${item.kbju.c}</span>
                            </div>
                            <div class="item-meta">${item.meta}</div>
                        </div>
                        <div class="item-price">${item.price} ₽</div>
                    </div>
                </div>
            `).join('')}
        </div>
    `).join('');
}

function findItem(id) {
    for (const cat of menuData) {
        const found = cat.items.find(i => i.id === id);
        if (found) return found;
    }
    return null;
}

/* ========== КАРТОЧКА БЛЮДА ========== */
function openDish(id) {
    const item = findItem(id);
    if (!item) return;
    currentDish = item;

    const imgEl = document.getElementById('modalImg');
    imgEl.src = item.img;
    imgEl.style.opacity = '1';
    imgEl.onerror = function() { this.style.opacity = '0.15'; };

    document.getElementById('modalTitle').textContent = item.name;
    document.getElementById('modalDesc').textContent = item.desc || 'Описание отсутствует';
    document.getElementById('modalMeta').textContent = 'Вес/объём: ' + item.meta;
    document.getElementById('modalPrice').textContent = item.price + ' ₽';
    document.getElementById('modalKbju').innerHTML = `
        <div class="modal-kbju-item cal"><span class="val">${item.kbju.cal}</span><span class="lbl">ккал</span></div>
        <div class="modal-kbju-item"><span class="val">${item.kbju.p} г</span><span class="lbl">Белки</span></div>
        <div class="modal-kbju-item"><span class="val">${item.kbju.f} г</span><span class="lbl">Жиры</span></div>
        <div class="modal-kbju-item"><span class="val">${item.kbju.c} г</span><span class="lbl">Углеводы</span></div>
    `;

    const btn = document.getElementById('modalAddBtn');
    btn.textContent = 'Добавить';
    btn.classList.remove('added');

    document.getElementById('dishModal').classList.add('active');
    document.body.style.overflow = 'hidden';
}

function addFromModal() {
    if (!currentDish) return;
    addToCart(currentDish.id);
    const btn = document.getElementById('modalAddBtn');
    btn.textContent = '✓ Добавлено';
    btn.classList.add('added');
    setTimeout(() => closeModal(null, 'dishModal'), 600);
}

/* ========== ТРЕКЕР ========== */
function addToCart(id, delta = 1) {
    const item = findItem(id);
    if (!item) return;
    if (!cart[id]) cart[id] = { item, qty: 0 };
    cart[id].qty += delta;
    if (cart[id].qty <= 0) delete cart[id];
    updateCartUI();
}

function clearCart() {
    if (Object.keys(cart).length === 0) return;
    if (confirm('Очистить весь трекер?')) {
        cart = {};
        updateCartUI();
    }
}

function updateCartUI() {
    const count = Object.values(cart).reduce((s, e) => s + e.qty, 0);
    const el = document.getElementById('cartCount');
    el.textContent = count;
    el.dataset.count = count;
    if (document.getElementById('cartModal').classList.contains('active')) renderCartContent();
}

function renderCartContent() {
    const container = document.getElementById('cartContent');
    const entries = Object.entries(cart);

    if (entries.length === 0) {
        container.innerHTML = `<div class="cart-empty">Пока ничего не отмечено 🍽️<br><br>Нажмите на блюдо из меню</div>`;
        return;
    }

    let totalCal = 0, totalP = 0, totalF = 0, totalC = 0, totalPrice = 0;
    entries.forEach(([, e]) => {
        totalCal += e.item.kbju.cal * e.qty;
        totalP   += e.item.kbju.p   * e.qty;
        totalF   += e.item.kbju.f   * e.qty;
        totalC   += e.item.kbju.c   * e.qty;
        totalPrice += e.item.price  * e.qty;
    });

    container.innerHTML = `
        <div class="cart-items">
            ${entries.map(([id, e]) => {
                const itemCal = e.item.kbju.cal * e.qty;
                const itemP = (e.item.kbju.p * e.qty).toFixed(1);
                const itemF = (e.item.kbju.f * e.qty).toFixed(1);
                const itemC = (e.item.kbju.c * e.qty).toFixed(1);
                return `
                <div class="cart-item">
                    <img src="${e.item.img}" class="cart-item-img" alt="${e.item.name}"
                         onerror="this.style.opacity='0.15'">
                    <div class="cart-item-info">
                        <div class="cart-item-name">${e.item.name}</div>
                        <div class="cart-item-kbju">
                            <span class="cal">🔥 ${itemCal} ккал</span> · Б: ${itemP} · Ж: ${itemF} · У: ${itemC}
                        </div>
                    </div>
                    <div class="cart-item-qty">
                        <button onclick="addToCart('${id}', -1)">−</button>
                        <span class="qty-val">${e.qty}</span>
                        <button onclick="addToCart('${id}', 1)">+</button>
                    </div>
                </div>
            `}).join('')}
        </div>
        <div class="cart-footer">
            <div class="cart-footer-title">Итого за всё</div>
            <div class="cart-totals">
                <div class="total-box cal"><span class="val">${Math.round(totalCal)}</span><span class="lbl">ккал</span></div>
                <div class="total-box p"><span class="val">${totalP.toFixed(1)}</span><span class="lbl">Белки, г</span></div>
                <div class="total-box f"><span class="val">${totalF.toFixed(1)}</span><span class="lbl">Жиры, г</span></div>
                <div class="total-box c"><span class="val">${totalC.toFixed(1)}</span><span class="lbl">Углеводы, г</span></div>
            </div>
            <div class="cart-sum-price">
                <span>Общая стоимость съеденного:</span>
                <span class="sum">${totalPrice} ₽</span>
            </div>
        </div>
    `;
}

/* ========== ИНИЦИАЛИЗАЦИЯ ========== */
renderMenu();
updateCartUI();

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        const open = document.querySelectorAll('.modal-overlay.active');
        if (open.length > 0) {
            open[open.length - 1].classList.remove('active');
            setTimeout(() => {
                if (!document.querySelector('.modal-overlay.active')) document.body.style.overflow = '';
            }, 50);
        }
    }
});
</script>
