<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Безлимит · Бык и Берег</title>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
        font-family: 'Segoe UI', Roboto, Arial, sans-serif;
        background: #F5F0E8;
        color: #2C2C2C;
        line-height: 1.5;
        padding: 40px 20px 60px;
    }
    .container { max-width: 1100px; margin: 0 auto; }

    /* ===== ЗАГОЛОВОК ===== */
    .page-header { text-align: center; margin-bottom: 36px; }
    .page-header h1 {
        font-size: 2.4rem; font-weight: 900; text-transform: uppercase;
        letter-spacing: 2px; color: #1A1A1A; line-height: 1; margin-bottom: 10px;
    }
    .page-header h1 span { color: #A6812A; }
    .page-header p { font-size: 1rem; color: #6B6B6B; }

    /* ===== ПЛАВАЮЩИЕ КНОПКИ ===== */
    .floating-buttons {
        position: fixed; top: 20px; right: 20px; z-index: 1000;
        display: flex; flex-direction: column; gap: 12px; align-items: flex-end;
    }
    .float-btn {
        background: #1A1A1A; color: #fff; border: none; border-radius: 50px;
        padding: 12px 20px; font-size: 0.95rem; font-weight: 700; cursor: pointer;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        display: flex; align-items: center; gap: 8px;
        transition: transform 0.2s, background 0.2s; white-space: nowrap;
    }
    .float-btn:hover { background: #333; transform: scale(1.05); }
    .float-btn.rules { background: #A6812A; }
    .float-btn.rules:hover { background: #8B6B22; }
    .float-btn .badge {
        background: #E74C3C; color: #fff; border-radius: 50%;
        min-width: 22px; height: 22px;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.75rem; font-weight: 800; padding: 0 6px;
    }
    .float-btn .badge[data-count="0"] { display: none; }

    /* ===== МЕНЮ ===== */
    .menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 32px; }
    .category {
        background: #FFFFFF; border-radius: 16px; padding: 22px 26px 26px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .category-title {
        font-size: 1.2rem; font-weight: 800; text-transform: uppercase;
        letter-spacing: 0.5px; color: #1A1A1A; margin-bottom: 16px;
        padding-bottom: 10px; border-bottom: 2px solid #E8E0D4;
    }
    .category-title small {
        display: block; font-size: 0.72rem; font-weight: 400;
        text-transform: none; letter-spacing: 0; color: #9A9A9A; margin-top: 2px;
    }
    .item {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 11px 0; border-bottom: 1px solid #F0EBE3;
        cursor: pointer; transition: background 0.2s; border-radius: 8px;
    }
    .item:hover { background: #FAF7F2; }
    .item:last-child { border-bottom: none; }
    .item-img {
        width: 60px; height: 60px; object-fit: cover;
        border-radius: 10px; flex-shrink: 0; background: #F0EBE3;
    }
    .item-body {
        flex: 1; min-width: 0;
        display: flex; justify-content: space-between;
        align-items: flex-start; gap: 10px;
    }
    .item-info { flex: 1; min-width: 0; }
    .item-name {
        font-weight: 700; font-size: 0.9rem; color: #1A1A1A;
        text-transform: uppercase; letter-spacing: 0.3px;
    }
    .item-desc {
        font-size: 0.78rem; color: #7A7A7A; margin-top: 3px; line-height: 1.35;
    }
    .item-meta { font-size: 0.72rem; color: #A0A0A0; margin-top: 4px; }
    .item-kbju {
        display: inline-flex; flex-wrap: wrap; gap: 8px; margin-top: 6px;
        padding: 4px 10px; background: #F0F7F0; border: 1px solid #D4E8D4;
        border-radius: 8px; font-size: 0.68rem; color: #4A7C4A; font-weight: 600;
    }
    .kbju-cal { color: #D35400; }
    .item-price {
        font-weight: 800; font-size: 1rem; color: #1A1A1A;
        white-space: nowrap; padding-top: 2px; text-align: right;
    }

    /* ===== МОДАЛКИ ===== */
    .modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.65); z-index: 2000;
        align-items: flex-start; justify-content: center;
        padding: 20px; overflow-y: auto; animation: fadeIn 0.2s ease;
    }
    .modal-overlay.active { display: flex; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal {
        background: #fff; border-radius: 20px; width: 100%; max-width: 520px;
        position: relative; animation: slideUp 0.25s ease; margin: auto;
    }
    .modal-header {
        padding: 20px 28px; border-bottom: 1px solid #F0EBE3;
        display: flex; justify-content: space-between; align-items: center;
        position: sticky; top: 0; background: #fff;
        border-radius: 20px 20px 0 0; z-index: 5;
    }
    .modal-header h2 {
        font-size: 1.2rem; font-weight: 800; text-transform: uppercase;
        color: #1A1A1A; letter-spacing: 0.5px;
    }
    .modal-close {
        background: #F5F0E8; color: #1A1A1A; border: none; border-radius: 50%;
        width: 36px; height: 36px; font-size: 1.3rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; transition: background 0.2s;
    }
    .modal-close:hover { background: #E8E0D4; }

    /* Карточка блюда */
    .dish-modal { max-width: 520px; }
    .dish-modal .modal-close {
        position: absolute; top: 14px; right: 14px;
        background: rgba(0,0,0,0.5); color: #fff; z-index: 10;
    }
    .dish-modal .modal-close:hover { background: rgba(0,0,0,0.8); }
    .modal-img {
        width: 100%; height: 260px; object-fit: cover;
        display: block; background: #F0EBE3;
        border-radius: 20px 20px 0 0;
    }
    .modal-content { padding: 24px 28px 28px; }
    .modal-title {
        font-size: 1.5rem; font-weight: 800; color: #1A1A1A;
        text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px;
    }
    .modal-desc { font-size: 0.95rem; color: #6B6B6B; line-height: 1.5; margin-bottom: 14px; }
    .modal-meta { font-size: 0.85rem; color: #A0A0A0; margin-bottom: 16px; }
    .modal-kbju {
        display: flex; flex-wrap: wrap; gap: 10px; padding: 14px 16px;
        background: #F0F7F0; border: 1px solid #D4E8D4;
        border-radius: 12px; margin-bottom: 20px;
    }
    .modal-kbju-item { flex: 1; min-width: 70px; text-align: center; }
    .modal-kbju-item .val { font-size: 1.05rem; font-weight: 800; color: #2C2C2C; display: block; }
    .modal-kbju-item .lbl {
        font-size: 0.7rem; color: #7A7A7A;
        text-transform: uppercase; letter-spacing: 0.5px;
    }
    .modal-kbju-item.cal .val { color: #D35400; }
    .modal-footer {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; padding-top: 16px; border-top: 1px solid #F0EBE3;
    }
    .modal-price { font-size: 1.6rem; font-weight: 800; color: #1A1A1A; }
    .btn-primary {
        background: #1A1A1A; color: #fff; border: none; border-radius: 12px;
        padding: 14px 28px; font-size: 1rem; font-weight: 700; cursor: pointer;
        transition: background 0.2s, transform 0.1s; white-space: nowrap;
    }
    .btn-primary:hover { background: #333; }
    .btn-primary:active { transform: scale(0.97); }
    .btn-primary.added { background: #27AE60; }

    /* Правила */
    .rules-body { padding: 24px 28px 28px; }
    .rules-header {
        text-align: center; margin-bottom: 24px;
        padding-bottom: 18px; border-bottom: 2px dashed #E8E0D4;
    }
    .rules-header h2 {
        font-size: 1.8rem; font-weight: 900; text-transform: uppercase;
        color: #1A1A1A; letter-spacing: 1px; margin-bottom: 6px;
    }
    .rules-header h2 span { color: #A6812A; }
    .rules-header p { font-size: 0.95rem; color: #6B6B6B; }
    .rules-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
    .rule-card {
        background: #FAF7F2; border-radius: 10px; padding: 12px 14px;
        display: flex; gap: 10px; align-items: flex-start;
        border-left: 3px solid #A6812A;
    }
    .rule-icon { font-size: 1.1rem; flex-shrink: 0; line-height: 1.2; }
    .rule-text { font-size: 0.82rem; color: #4A4A4A; line-height: 1.4; }
    .rule-text strong { color: #1A1A1A; }
    .tip-box {
        background: #A6812A; color: #fff; border-radius: 14px; padding: 18px 22px;
        display: flex; gap: 14px; align-items: flex-start; margin-top: 20px;
    }
    .tip-box .tip-icon { font-size: 1.6rem; line-height: 1; }
    .tip-box .tip-content { font-size: 0.88rem; line-height: 1.45; }
    .tip-box .tip-content strong {
        display: block; font-size: 0.95rem; margin-bottom: 4px;
        text-transform: uppercase; letter-spacing: 0.5px;
    }
    .rules-footer {
        text-align: center; font-size: 0.72rem; color: #A0A0A0;
        margin-top: 18px; padding-top: 14px; border-top: 1px solid #F0EBE3;
    }

    /* Трекер */
    .cart-modal { max-width: 560px; }
    .cart-clear {
        background: none; border: 1px solid #E8E0D4; color: #A0A0A0;
        border-radius: 8px; padding: 6px 12px; font-size: 0.75rem;
        font-weight: 600; cursor: pointer; transition: all 0.2s;
    }
    .cart-clear:hover { background: #F5F0E8; color: #E74C3C; border-color: #E74C3C; }
    .cart-empty {
        padding: 60px 28px; text-align: center;
        color: #A0A0A0; font-size: 1rem;
    }
    .cart-items { padding: 12px 28px; }
    .cart-item {
        display: flex; align-items: center; gap: 14px;
        padding: 14px 0; border-bottom: 1px solid #F0EBE3;
    }
    .cart-item:last-child { border-bottom: none; }
    .cart-item-img {
        width: 56px; height: 56px; object-fit: cover;
        border-radius: 10px; flex-shrink: 0;
    }
    .cart-item-info { flex: 1; min-width: 0; }
    .cart-item-name {
        font-weight: 700; font-size: 0.9rem; color: #1A1A1A;
        text-transform: uppercase; margin-bottom: 4px;
    }
    .cart-item-kbju { font-size: 0.72rem; color: #4A7C4A; font-weight: 600; }
    .cart-item-kbju .cal { color: #D35400; }
    .cart-item-qty {
        display: flex; align-items: center; gap: 8px;
        background: #F5F0E8; border-radius: 10px; padding: 4px;
    }
    .cart-item-qty button {
        background: #fff; border: none; width: 28px; height: 28px;
        border-radius: 8px; font-size: 1.1rem; font-weight: 700;
        cursor: pointer; color: #1A1A1A;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.2s;
    }
    .cart-item-qty button:hover { background: #E8E0D4; }
    .cart-item-qty .qty-val {
        min-width: 24px; text-align: center; font-weight: 700; font-size: 0.9rem;
    }
    .cart-footer {
        padding: 20px 28px 28px; border-top: 2px solid #E8E0D4;
        background: #FAF7F2; border-radius: 0 0 20px 20px;
    }
    .cart-footer-title {
        font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px;
        color: #7A7A7A; font-weight: 700; margin-bottom: 12px; text-align: center;
    }
    .cart-totals { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px; }
    .total-box {
        background: #fff; border-radius: 12px; padding: 12px 8px;
        text-align: center; border: 1px solid #E8E0D4;
    }
    .total-box .val { font-size: 1.15rem; font-weight: 800; color: #1A1A1A; display: block; line-height: 1.2; }
    .total-box .lbl {
        font-size: 0.62rem; color: #7A7A7A;
        text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px;
    }
    .total-box.cal { background: #FFF3E8; border-color: #F5C99B; }
    .total-box.cal .val { color: #D35400; }
    .total-box.p { background: #F0F7F0; border-color: #D4E8D4; }
    .total-box.p .val { color: #27AE60; }
    .total-box.f { background: #F7F3F0; border-color: #E8DDD4; }
    .total-box.f .val { color: #A0522D; }
    .total-box.c { background: #F5F0E8; border-color: #E8E0D4; }
    .total-box.c .val { color: #B8860B; }
    .cart-sum-price {
        display: flex; justify-content: space-between; align-items: center;
        padding-top: 14px; border-top: 1px dashed #E8E0D4;
        font-size: 0.85rem; color: #7A7A7A;
    }
    .cart-sum-price .sum { font-size: 1.15rem; font-weight: 800; color: #1A1A1A; }

    /* ===== АДАПТИВ ===== */
    @media (max-width: 768px) {
        body { padding: 20px 14px 40px; }
        .page-header h1 { font-size: 1.6rem; }
        .page-header p { font-size: 0.9rem; }
        .floating-buttons { top: 12px; right: 12px; gap: 8px; }
        .float-btn { padding: 10px 16px; font-size: 0.85rem; }
        .menu-grid { grid-template-columns: 1fr; gap: 18px; }
        .category { padding: 16px 18px; }
        .item-name { font-size: 0.82rem; }
        .item-img { width: 52px; height: 52px; }
        .rules-grid { grid-template-columns: 1fr; }
        .rules-body { padding: 18px; }
        .rules-header h2 { font-size: 1.4rem; }
        .modal-header { padding: 16px 20px; }
        .modal-header h2 { font-size: 1rem; }
        .modal-content { padding: 20px; }
        .modal-img { height: 200px; }
        .modal-title { font-size: 1.2rem; }
        .cart-totals { grid-template-columns: repeat(2, 1fr); }
        .tip-box { flex-direction: column; gap: 10px; }
        .modal-overlay { padding: 10px; }
    }
</style>
</head>
<body>

<!-- Плавающие кнопки -->
<div class="floating-buttons">
    <button class="float-btn rules" onclick="openRules()">📋 Правила</button>
    <button class="float-btn" onclick="openCart()">
        🛒 Трекер <span class="badge" id="cartCount" data-count="0">0</span>
    </button>
</div>

<!-- Заголовок и меню -->
<div class="container">
    <div class="page-header">
        <h1>БЕЗЛИМИТ <span>899 ₽</span></h1>
        <p>Отмечайте съеденное и следите за КБЖУ прямо во время визита</p>
    </div>
    <div class="menu-grid" id="menuGrid"></div>
</div>

<!-- Модалка: Правила -->
<div class="modal-overlay" id="rulesModal" onclick="closeModal(event, 'rulesModal')">
    <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2>📋 Правила безлимита</h2>
            <button class="modal-close" onclick="closeModal(null, 'rulesModal')">×</button>
        </div>
        <div class="rules-body">
            <div class="rules-header">
                <h2>БЕЗЛИМИТ <span>ЗА 899 ₽</span></h2>
                <p>Безлимит на выбранные блюда из специального меню за 899 ₽* с человека.</p>
            </div>
            <div class="rules-grid">
                <div class="rule-card"><div class="rule-icon">💰</div><div class="rule-text"><strong>Цена</strong> — 899 ₽ с человека, фиксированная.</div></div>
                <div class="rule-card"><div class="rule-icon">👥</div><div class="rule-text"><strong>Кто участвует</strong> — за столом до 4 человек. Все гости за столом должны участвовать в безлимите.</div></div>
                <div class="rule-card"><div class="rule-icon">🍽️</div><div class="rule-text"><strong>Твой заказ</strong> — ешь его только сам, чужая тарелка неприкосновенна, делиться блюдами нельзя — иначе оплата по цене из основного меню.</div></div>
                <div class="rule-card"><div class="rule-icon">🔄</div><div class="rule-text"><strong>Как заказывать</strong> — можно заказывать любое количество блюд из безлимитного меню, без ограничения по числу подходов.</div></div>
                <div class="rule-card"><div class="rule-icon">✅</div><div class="rule-text"><strong>«Заказал — доедай»</strong> — если блюдо не доедено больше чем на 10%, оно оплачивается отдельно по полной цене из основного меню.</div></div>
                <div class="rule-card"><div class="rule-icon">🥤</div><div class="rule-text"><strong>Напитки</strong> — 1 напиток на человека. Чай и кофе безлимитно.</div></div>
                <div class="rule-card"><div class="rule-icon">🚫</div><div class="rule-text"><strong>С собой не уносят</strong> — всё нужно съесть прямо здесь.</div></div>
                <div class="rule-card"><div class="rule-icon">⏰</div><div class="rule-text"><strong>Когда действует</strong> — будни (пн–чт), с 11:00 до 16:00, последний заказ на безлимит принимается до 14:30. Время нахождения за столиком ограничено двумя часами.</div></div>
                <div class="rule-card"><div class="rule-icon">📅</div><div class="rule-text"><strong>По пятницам</strong> акция не работает.</div></div>
                <div class="rule-card"><div class="rule-icon">🧒</div><div class="rule-text"><strong>Дети</strong> — участие в акции могут принять дети, достигшие восьми лет.</div></div>
            </div>
            <div class="tip-box">
                <div class="tip-icon">💡</div>
                <div class="tip-content">
                    <strong>Совет гостю:</strong>
                    Начните с 2–3 блюд, доешьте — закажите следующее. Так вы точно не переплатите за недоеденное.
                </div>
            </div>
            <div class="rules-footer">*Действует только в зале Бык / Не суммируется с другими акциями</div>
        </div>
    </div>
</div>

<!-- Модалка: Карточка блюда -->
<div class="modal-overlay" id="dishModal" onclick="closeModal(event, 'dishModal')">
    <div class="modal dish-modal" onclick="event.stopPropagation()">
        <button class="modal-close" onclick="closeModal(null, 'dishModal')">×</button>
        <img class="modal-img" id="modalImg" src="" alt="">
        <div class="modal-content">
            <div class="modal-title" id="modalTitle"></div>
            <div class="modal-desc" id="modalDesc"></div>
            <div class="modal-meta" id="modalMeta"></div>
            <div class="modal-kbju" id="modalKbju"></div>
            <div class="modal-footer">
                <div class="modal-price" id="modalPrice"></div>
                <button class="btn-primary" id="modalAddBtn" onclick="addFromModal()">Добавить</button>
            </div>
        </div>
    </div>
</div>

<!-- Модалка: Трекер -->
<div class="modal-overlay" id="cartModal" onclick="closeModal(event, 'cartModal')">
    <div class="modal cart-modal" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2>🍽️ Мой трекер</h2>
            <div style="display:flex;gap:8px;align-items:center;">
                <button class="cart-clear" onclick="clearCart()">Очистить</button>
                <button class="modal-close" onclick="closeModal(null, 'cartModal')">×</button>
            </div>
        </div>
        <div id="cartContent"></div>
    </div>
</div>

<script>
/* ========== ДАННЫЕ МЕНЮ ========== */
const menuData = [
    {
        category: "Лимонады",
        note: "полная цена за блюдо",
        items: [
            { id: "l1", name: "Цитрусовый", desc: "лимон, апельсин, лайм, мята, сахарный сироп, минеральная вода, лёд", meta: "450 мл", price: 210, img: "img/lemonade-citrus.jpeg", kbju: {cal: 130, p: 0, f: 0, c: 32} },
            { id: "l2", name: "Малина-барбарис", desc: "сироп малина, сироп барбарис, мята, апельсин, сахарный сироп, сок лимона, минеральная вода, лёд", meta: "450 мл", price: 240, img: "img/lemonade-raspberry.jpeg", kbju: {cal: 150, p: 0, f: 0, c: 38} },
            { id: "l3", name: "Яблоко-груша-огурец", desc: "сироп яблоко, сироп груша, огурец, сахарный сироп, мята, сок лимона, минеральная вода, лёд", meta: "450 мл", price: 240, img: "img/lemonade-apple.jpeg", kbju: {cal: 110, p: 0.5, f: 0, c: 27} },
            { id: "l4", name: "Манго-маракуйя-баблгам", desc: "пюре манго-маракуйя, сироп баблгам, грейпфрут, мята, сахарный сироп, сок лимона, минеральная вода, лёд", meta: "450 мл", price: 240, img: "img/lemonade-mango.jpeg", kbju: {cal: 160, p: 0.5, f: 0, c: 40} }
        ]
    },
    {
        category: "Чай",
        note: "700 мл · безлимитно",
